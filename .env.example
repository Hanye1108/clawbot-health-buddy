# ============================================================
# clawbot-health-buddy 配置文件
# 复制为 .env 后填写（install.sh 会自动复制）。.env 里是密钥，不要提交到 Git，也不要发给别人。
# 格式：KEY=VALUE，等号两边不要有空格，值不用加引号。
# ============================================================

# ---- 必填：DeepSeek（https://platform.deepseek.com → API keys）----
DEEPSEEK_KEY=
# 对话模型和看图模型。模型名以 DeepSeek 官方文档为准，变了就改这里
DEEPSEEK_MODEL=deepseek-chat
VISION_MODEL=deepseek-flash

# ---- 必填：和风天气（https://console.qweather.com）----
# 项目里创建凭据，选 API KEY
QWEATHER_KEY=
# 控制台「设置」页里你自己的 API Host，形如 https://xxxxxx.re.qweatherapi.com
# 注意：官方文档示例里的 abcxyz.qweatherapi.com 是假的，不能用
QWEATHER_HOST=

# ---- 微信通道 ----
# ilink = 微信 ClawBot（推荐，个人微信里直接聊，不需要域名和端口）
# mp    = 公众号测试号（见 docs/MP_TEST_ACCOUNT.md）
CHANNEL=ilink
# 只回复扫码绑定的那个人（推荐 1）。如果确认是本人发消息却被日志提示"忽略"，改成 0
ILINK_ONLY_OWNER=1

# ---- 可选 ----
# 时区（影响提醒时间和"今天"的判断）
BOT_TIMEZONE=Asia/Shanghai
# 数据目录（数据库、ClawBot 登录凭据、备份），默认是项目下的 data/
# DATA_DIR=

# ---- 仅 CHANNEL=mp 时需要（公众号测试号）----
WX_TOKEN=
WX_APPID=
WX_APPSECRET=
WX_TEMPLATE_ID=
MP_PORT=5000
